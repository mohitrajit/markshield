# ==============================================================================
# Email & Agent Configuration (.env)
# Copy this file to .env and replace the values with your actual configuration.
# DO NOT commit your .env file to version control.
# ==============================================================================

# ==============================================================================
# Email & Agent Configuration (.env)
# Copy this file to .env and replace the values with your actual configuration.
# DO NOT commit your .env file to version control.
# ==============================================================================

# ==============================================================================
# Email Dispatch Provider Options:
#
# MarkShield supports two dispatch engines:
# 1. 'graph': Microsoft Graph REST API (OAuth 2.0 Modern Auth via Entra ID / Azure)
#             Recommended for enterprise Microsoft 365 tenancies. Does NOT require
#             an SMTP subscription or legacy basic authentication.
# 2. 'smtp':  Standard SMTP relay (Gmail App Passwords, local relays, or M365 SMTP AUTH).
# ==============================================================================

# ------------------------------------------------------------------------------
# Option 1: Microsoft Graph API (Recommended for Enterprise Microsoft 365)
# ------------------------------------------------------------------------------
# Earlier, MarkShield used legacy SMTP relay. We upgraded to Microsoft Graph API
# to enable direct, passwordless enterprise mail delivery via Microsoft Entra ID.
# Setup Guide:
# 1. Register an App in Microsoft Entra admin center (https://entra.microsoft.com).
# 2. Add API permission: Microsoft Graph -> Application -> Mail.Send.
# 3. Grant Admin Consent for the directory.
# 4. Generate a Client Secret under 'Certificates & secrets'.
# ------------------------------------------------------------------------------
MAIL_PROVIDER=graph
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
AZURE_CLIENT_SECRET=your_azure_client_secret_value
MAIL_FROM=mohit.raj@radiantglobaltech.com
MAIL_TO=mohit.raj@radiantglobaltech.com
# MAIL_CC=lead1@example.com, lead2@example.com
# MAIL_BCC=rag-audit@example.com

# ------------------------------------------------------------------------------
# Option 2: Gmail SMTP Relay (Preserved for Non-M365 / Personal Accounts)
# ------------------------------------------------------------------------------
# Preserved for backward compatibility. Requires Google 16-character App Password.
# ------------------------------------------------------------------------------
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# MAIL_FROM=your-email@gmail.com
# MAIL_TO=recipient@example.com

# ------------------------------------------------------------------------------
# Option 3: Local / Company Internal SMTP Relay (No authentication)
# ------------------------------------------------------------------------------
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.company.internal
# SMTP_PORT=25
# SMTP_SECURITY=none
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=md-verifier@company.com
# MAIL_TO=team@company.com

# ------------------------------------------------------------------------------
# Option 4: Legacy Microsoft 365 SMTP Relay (Only if SMTP AUTH is enabled)
# ------------------------------------------------------------------------------
# MAIL_PROVIDER=smtp
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=your-email@outlook.com
# SMTP_PASS=your-password
# MAIL_FROM=your-email@outlook.com
# MAIL_TO=recipient@example.com

# --- Optional Agent Folder & Polling Settings ---
# INBOX=inbox
# VERIFIED=verified
# FAILED=failed
# REPORTS=reports
# POLL_SECONDS=30
# SETTLE_SECONDS=5
# SMTP_TIMEOUT=30

# --- Email Attachment Options ---
# Set to 'true' to package all processed (auto-repaired & verified/failed) .md files into a single clean .zip archive attached to the email.
# Set to 'false' to only attach the Excel report workbook.
ATTACH_MD_FILES=true

