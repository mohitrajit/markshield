# ==============================================================================
# Email & Agent Configuration (.env)
# Copy this file to .env and replace the values with your actual configuration.
# DO NOT commit your .env file to version control.
# ==============================================================================

# --- SMTP Configuration ---
# Choose your provider setup below:

# ------------------------------------------------------------------------------
# Option 1: Gmail (Recommended for Google / Gmail accounts)
# Note: You must use a 16-character Google "App Password", not your normal password.
# To generate one: Google Account -> Security -> 2-Step Verification -> App Passwords
# ------------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
MAIL_FROM=your-email@gmail.com
MAIL_TO=recipient@example.com
# MAIL_CC=colleague1@example.com, colleague2@example.com
# MAIL_BCC=archive@example.com

# ------------------------------------------------------------------------------
# Option 2: Microsoft 365 / Outlook
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=your-email@outlook.com
# SMTP_PASS=your-password
# MAIL_FROM=your-email@outlook.com
# MAIL_TO=recipient@example.com

# ------------------------------------------------------------------------------
# Option 3: Local / Company Internal Relay (No authentication)
# ------------------------------------------------------------------------------
# SMTP_HOST=smtp.company.internal
# SMTP_PORT=25
# SMTP_SECURITY=none
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=md-verifier@company.com
# MAIL_TO=team@company.com

# --- Optional Agent Folder & Polling Settings ---
# INBOX=inbox
# VERIFIED=verified
# FAILED=failed
# REPORTS=reports
# POLL_SECONDS=30
# SETTLE_SECONDS=5
# SMTP_TIMEOUT=30

